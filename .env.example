# Copy to .env and fill in. All values have sensible defaults except secrets.

# --- Database ---
DATABASE_URL=postgresql+psycopg://mlgpt:mlgpt@localhost:5432/mlgpt

# --- Drift detection ---
DRIFT_CHECK_INTERVAL_SECONDS=60
PSI_THRESHOLD=0.2
NULL_RATE_THRESHOLD=0.25
DRIFT_WINDOW_MINUTES=10
MIN_ROWS_FOR_DRIFT=100

# --- Performance-decay trigger (catches concept/world drift) ---
PERF_ACC_DROP=0.03
PERF_AUC_DROP=0.03
PERF_MIN_LABELED=100

# --- Root-cause agent (Groq, OpenAI-compatible) ---
# Without a key the agent falls back to a deterministic, still-cited explanation.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=2

# --- Reference data storage ---
REFERENCE_DIR=/tmp/mlgpt_reference
